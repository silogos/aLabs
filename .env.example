# ---- API ----
# A long random string used to sign sessions.
BETTER_AUTH_SECRET=change-me
# Postgres connection (optional — the API runs on an in-memory store if unset).
# DATABASE_URL=postgres://helix:helix@localhost:5432/helix
PORT=8788
# Where the web app lives — OAuth logins redirect back here after the callback.
WEB_URL=http://localhost:5173

# ---- Google SSO (optional — /auth/oauth/google returns 503 until both are set) ----
# Create credentials at https://console.cloud.google.com/apis/credentials (OAuth client,
# type "Web application"). Authorized redirect URI: <api-origin>/auth/oauth/google/callback
# e.g. http://localhost:8788/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Infrastructure (to be selected) ----
# STORAGE_*   object storage (S3-compatible)
# EMAIL_*     transactional email
# PAYMENT_*   billing provider (e.g. Stripe)
# AI_*        AI provider

# ---- Web ----
# Vite dev proxy target for /api. Defaults to http://localhost:8788.
VITE_API_URL=http://localhost:8788
