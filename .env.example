# ---- App (Next.js serves web + API on one port) ----
# A long random string used to sign sessions.
BETTER_AUTH_SECRET=change-me
# Where the app lives — OAuth logins redirect back here after the callback.
WEB_URL=http://localhost:3000
# Uploads directory (defaults to <repo>/apps/web/uploads; set when mounting a volume).
# UPLOADS_DIR=/data/uploads

# Postgres — REQUIRED (the auth domain persists here; other modules follow).
# Matches the docker-compose service: `pnpm dev:db` starts it.
# For the Next.js app, put this in apps/web/.env (Next loads env from the app dir).
DATABASE_URL=postgres://alabs:alabs@localhost:5432/alabs

# ---- Google SSO (optional — /auth/oauth/google returns 503 until both are set) ----
# Create credentials at https://console.cloud.google.com/apis/credentials (OAuth client,
# type "Web application"). Authorized redirect URI: <app-origin>/api/auth/oauth/google/callback
# e.g. http://localhost:3000/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Infrastructure (to be selected) ----
# STORAGE_*   object storage (S3-compatible)
# EMAIL_*     transactional email
# PAYMENT_*   billing provider (e.g. Stripe)
# AI_*        AI provider
