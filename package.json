{
  "name": "alabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "aLabs — a documentation-first project management platform (Atlas Platform 2.0).",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @pmin/web dev",
    "dev:api": "pnpm --filter @pmin/api dev",
    "dev:db": "docker compose up -d postgres",
    "dev:db:down": "docker compose stop postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write apps/web",
    "format:check": "prettier --check apps/web",
    "clean": "rm -rf apps/*/dist apps/*/.next packages/*/dist node_modules/.cache .turbo"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "turbo": "^2",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/core": "3.29.2",
      "@tiptap/pm": "3.29.2"
    }
  }
}
